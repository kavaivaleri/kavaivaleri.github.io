---
import { Image } from "astro:assets";
import type { WorkCase } from "../lib/content";

type Props = {
  project: WorkCase;
};

const { project } = Astro.props;
---

<article class="work-card">
  {project.heroImage ? (
    <a class="work-card-image" href={`/work/${project.slug}/`} aria-label={project.title}>
      <Image
        src={project.heroImage}
        alt=""
        loading="lazy"
        widths={[360, 540, 720]}
        sizes="(min-width: 900px) 33vw, calc(100vw - 2rem)"
      />
    </a>
  ) : null}
  <div class="work-card-body">
    <p class="kicker">{project.category} / {project.completed}</p>
    <h2><a href={`/work/${project.slug}/`}>{project.title}</a></h2>
    <p>{project.headline}</p>
    <ul class="tag-list" aria-label="Technologies">
      {project.tags.slice(0, 4).map((item) => <li>{item}</li>)}
    </ul>
    <a class="card-link" href={`/work/${project.slug}/`}>View case study</a>
  </div>
</article>
