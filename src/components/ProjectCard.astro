---
import type { Project } from "../lib/content";

type Props = {
  project: Project;
};

const { project } = Astro.props;
---

<article class="surface card">
  {project.image ? (
    <a class="card-image" href={`/projects/${project.slug}/`} aria-label={project.title}>
      <img src={project.image} alt="" loading="lazy" />
    </a>
  ) : null}
  <div class="card-body">
    <p class="kicker">{project.category} / {project.year}</p>
    <h2><a href={`/projects/${project.slug}/`}>{project.title}</a></h2>
    <p>{project.description}</p>
    <ul class="tag-list" aria-label="Technologies">
      {project.technologies.map((item) => <li>{item}</li>)}
    </ul>
    <a class="card-link" href={`/projects/${project.slug}/`}>Read project</a>
  </div>
</article>
