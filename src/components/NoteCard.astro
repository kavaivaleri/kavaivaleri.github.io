---
import { Image } from "astro:assets";
import type { Note } from "../lib/content";
import { formatDate } from "../lib/utils";

type Props = {
  note: Note;
};

const { note } = Astro.props;
---

<article class="surface card note-card">
  {note.image ? (
    <a class="card-image" href={`/blog/${note.slug}/`} aria-label={note.title}>
      <Image
        src={note.image}
        alt=""
        loading="lazy"
        widths={[180, 240, 320]}
        sizes="(min-width: 900px) 180px, 38vw"
      />
    </a>
  ) : null}
  <div class="card-body">
    <p class="kicker">
      {formatDate(note.publishedAt)}
      {note.readTime ? ` / ${note.readTime}` : ""}
    </p>
    <h2><a href={`/blog/${note.slug}/`}>{note.title}</a></h2>
    <p>{note.description}</p>
    {note.tags.length ? (
      <ul class="tag-list" aria-label="Tags">
        {note.tags.slice(0, 4).map((tag) => <li>{tag}</li>)}
      </ul>
    ) : null}
    <a class="card-link" href={`/blog/${note.slug}/`}>Read post</a>
  </div>
</article>
