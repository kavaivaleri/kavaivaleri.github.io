---
import { getCollection } from "astro:content";

import RedirectPage from "../../components/RedirectPage.astro";
import { slugFromId } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("notes", ({ data }) => data.published !== false);

  return entries.map((entry) => ({
    params: { slug: slugFromId(entry.id) },
  }));
}

const slug = Astro.params.slug;
---

<RedirectPage to={`/blog/${slug}/`} title="Blog" />
