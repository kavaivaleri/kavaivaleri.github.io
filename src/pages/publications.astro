---
import PublicationCard from "../components/PublicationCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublications } from "../lib/content";

const publications = await getPublications();
---

<BaseLayout
  title="Publications"
  description="External AI, ML, prompt engineering, and technical writing publications by Valeriia Kuka."
>
  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Publications</p>
        <h1>External articles and editorial work</h1>
        <p>
          A library of AI/ML explainers, company profiles, research summaries,
          tutorials, and industry analysis.
        </p>
      </div>
      <div class="grid grid-2" style="margin-top: 1.75rem;">
        {publications.map((publication) => <PublicationCard publication={publication} />)}
      </div>
    </div>
  </section>
</BaseLayout>
