---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getProfile } from "../lib/content";

const profile = await getProfile();
const services = [
  {
    id: "founder-led-content",
    title: "Founder-Led Content",
    description:
      "Strategic content development for founders and technical leaders building a credible public voice.",
    details:
      "I translate subject-matter expertise into authoritative content for LinkedIn and X, working from interviews, recordings, notes, and technical source material. Engagements can cover editorial positioning, content planning, writing, cross-channel adaptation, publication support, and performance analysis.",
    groups: [
      {
        title: "What the service can include",
        items: [
          "Content positioning, voice, and editorial themes",
          "Regular interviews or content-capture sessions",
          "Topic and audience research",
          "Editorial calendar development",
          "LinkedIn and X content",
          "Long-form posts and threads",
          "Adaptation of one idea across multiple formats",
          "Editing and revision",
          "Publication support",
          "Performance reviews and editorial recommendations",
        ],
      },
    ],
  },
  {
    id: "technical-ai-ml-content",
    title: "Technical AI/ML Content",
    description:
      "Research-led editorial content for companies working in artificial intelligence, machine learning, and developer technology.",
    details:
      "I produce technically accurate, accessible content grounded in primary sources, product documentation, and subject-matter expertise. Formats include technical explainers, in-depth articles, educational content, founder bylines, product-focused content, case studies, and substantive editing.",
    groups: [
      {
        title: "What the service can include",
        items: [
          "Topic development and editorial briefing",
          "Source and competitor research",
          "Subject-matter expert interviews",
          "Article structure and outline",
          "Writing and revision",
          "Fact-checking and source attribution",
          "Editing for accuracy, clarity, and narrative flow",
          "Search optimization where relevant",
          "Formatting and publication support",
        ],
      },
    ],
  },
  {
    id: "newsletter-strategy-production",
    title: "Newsletter Strategy and Production",
    description:
      "Editorial strategy and end-to-end production for technical newsletters.",
    details:
      "I develop the newsletter's positioning, structure, recurring formats, and editorial roadmap, then manage the research, writing, editing, and preparation of individual editions. I also support content distribution, sponsor integration, performance analysis, and ongoing editorial improvement.",
    groups: [
      {
        title: "What the service can include",
        items: [
          "Audience and newsletter positioning",
          "Editorial concept and content structure",
          "Voice and style development",
          "Recurring sections and formats",
          "Editorial calendar",
          "Topic research",
          "Writing and substantive editing",
          "Subject lines and preview text",
          "Sponsor-copy editing and integration",
          "Formatting and publication preparation",
          "Cross-channel content repurposing",
          "Performance analysis and editorial recommendations",
        ],
      },
    ],
  },
];
---

<BaseLayout
  title="Services"
  description="Content strategy and editorial execution for AI companies, technical products, and industry experts."
>
  <section class="section">
    <div class="shell">
      <div class="section-heading">
        <p class="eyebrow">Services</p>
        <h1>Content strategy and editorial execution</h1>
        <p>
          Content strategy and editorial execution for AI companies, technical
          products, and industry experts.
        </p>
      </div>
    </div>
  </section>

  <section class="section-tight">
    <div class="shell grid grid-2">
      {services.map((service) => (
        <article class="surface card" id={service.id}>
          <div class="card-body">
            <h2>{service.title}</h2>
            <p>{service.description}</p>
            <p>{service.details}</p>
            <div class="service-groups">
              {service.groups.map((group) => (
                <div class="service-group">
                  <h3>{group.title}</h3>
                  <ul>
                    {group.items.map((item) => <li>{item}</li>)}
                  </ul>
                </div>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <div class="cta-band">
        <p class="eyebrow">Work together</p>
        <h2>Need stronger content strategy or editorial support?</h2>
        <div class="button-row">
          <a class="button-secondary" href={`mailto:${profile.email}`}>Email me</a>
          <a class="button-secondary" href="/work/">View case studies</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
