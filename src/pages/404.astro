---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page not found" description="This page could not be found.">
  <section class="section">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">The page you are looking for is not available.</p>
      <div class="button-row">
        <a class="button-primary" href="/">Go home</a>
        <a class="button-secondary" href="/projects/">View work</a>
      </div>
    </div>
  </section>
</BaseLayout>
