---
import Footer from "../components/Footer.astro";
import SiteNav from "../components/SiteNav.astro";
import { absoluteUrl } from "../lib/seo";
import { siteConfig } from "../lib/site";
import "../styles/global.css";

type ImageSource = string | { src: string };

type Props = {
  title?: string;
  description?: string;
  image?: ImageSource;
  type?: "website" | "article";
};

const {
  title,
  description = siteConfig.description,
  image = "/images/photo2.jpg",
  type = "website",
} = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.name}` : siteConfig.name;
const canonical = new URL(Astro.url.pathname, siteConfig.siteUrl).toString();
const imageUrl = absoluteUrl(typeof image === "string" ? image : image.src);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={`${siteConfig.name} Blog`} href="/feed.xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
  </head>
  <body>
    <SiteNav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
